# ==============================================================================
# MANGALURU WATER INTELLIGENCE - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins (comma-separated domains, or * for all)
# Example for deployed frontend: https://mangaluru-water-intelligence.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=*

# Database Configuration (Optional)
# Leave blank to use zero-config local SQLite (mangaluru_water.db) with auto-seeding.
# If using hosted PostgreSQL (e.g. Neon, Supabase, Render Postgres), paste connection URI:
DATABASE_URL=
